# Copy this file to .env and fill in the keys. .env is never committed.

# Azure Speech: Azure portal > create a "Speech service" resource (free F0 tier is fine)
# > Keys and Endpoint. Region is e.g. northeurope or westeurope.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ElevenLabs: elevenlabs.io > Profile > API keys.
ELEVENLABS_API_KEY=
# Optional: comma-separated voice IDs to test. Default picks one female and one male premade voice.
ELEVENLABS_VOICE_IDS=
# Optional: models to try. Each model and voice costs credits (about 1,000 characters per voice per model).
ELEVENLABS_MODELS=eleven_v3,eleven_multilingual_v2

# Claude API key for writing the scripts: platform.claude.com > API keys
ANTHROPIC_API_KEY=
