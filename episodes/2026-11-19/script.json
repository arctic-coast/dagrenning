{
  "title": "Hált á fimmtudegi",
  "segments": [
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Góðan daginn frá Húsavík. Í dag er fimmtudagur, nítjándi nóvember. Klukkan er um hálf sjö.",
      "translation": "Good morning from Húsavík. Today is Thursday, the nineteenth of November. It is about half past six."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Veðrið í dag.",
      "translation": "The weather today."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Snemma í morgun snjóar aðeins. Svo verður alskýjað.",
      "translation": "Early this morning it is snowing a little. Then it will be overcast."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Hitinn í dag er mínus tvær til mínus þrjár gráður. Í kvöld kólnar, niður í mínus fjórar gráður.",
      "translation": "The temperature today is minus two to minus three degrees. This evening it gets colder, down to minus four degrees."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Það er hægur vindur úr suðsuðaustri.",
      "translation": "There is a light wind from the south-southeast."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Sólin kemur upp klukkan tólf mínútur yfir tíu og sest klukkan tuttugu og fjórar mínútur í fjögur.",
      "translation": "The sun rises at twelve minutes past ten and sets at twenty-four minutes to four."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fréttir dagsins.",
      "translation": "Today's news."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Seðlabankinn breytir ekki stýrivöxtum. Þeir eru áfram átta prósent. Bankinn segir að verðbólga sé enn of mikil.",
      "translation": "The Central Bank is not changing its policy interest rate. It stays at eight percent. The bank says inflation is still too high."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Stjarnan vann ÍBV í bikarkeppni kvenna í handbolta. Leikurinn endaði fjörutíu og þrjú gegn fjörutíu. Lið KA og Þórs frá Akureyri fór líka áfram.",
      "translation": "Stjarnan beat ÍBV in the women's handball cup. The game ended forty-three to forty. The KA and Þór team from Akureyri also went through."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fimm orð dagsins.",
      "translation": "Five words of the day."
