{
  "title": "Rigning og jólasveinar",
  "segments": [
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Góðan daginn frá Húsavík.",
      "translation": "Good morning from Húsavík."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Í dag er þriðjudagur, tuttugasti og fjórði nóvember. Klukkan er um hálf sjö.",
      "translation": "Today is Tuesday, the twenty-fourth of November. It is about half past six."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Veðrið í dag.",
      "translation": "The weather today."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Í morgun er alskýjað og hitinn er sex gráður. Það er suðaustanátt, sjö til tíu metrar á sekúndu.",
      "translation": "This morning it is overcast and the temperature is six degrees. There is a southeasterly wind, seven to ten metres per second."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Um hádegi er lítils háttar rigning. Hitinn í dag verður fimm til sex gráður.",
      "translation": "Around noon there is light rain. The temperature today will be five to six degrees."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Það hvessir síðdegis, allt að tólf metrar á sekúndu. Í kvöld kemur aftur lítils háttar rigning.",
      "translation": "The wind picks up in the afternoon, up to twelve metres per second. This evening light rain comes again."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Sólin kemur upp um hálf ellefu og sest klukkan nítján mínútur yfir þrjú.",
      "translation": "The sun rises around half past ten and sets at nineteen minutes past three."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Viðburðir.",
      "translation": "Events."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Á sunnudaginn, tuttugasta og níunda nóvember, verður jólamarkaður á Ráðhústorgi á Akureyri. Hann er opinn frá klukkan tvö til fimm. Aðgangur er ókeypis.",
      "translation": "On Sunday, the twenty-ninth of November, there will be a Christmas market at Ráðhústorg in Akureyri. It is open from two to five. Admission is free."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Frá fyrsta desember verða jólasveinarnir í Dimmuborgum við Mývatn. Það er næsta þriðjudag. Þeir verða þar til tuttugasta og þriðja desember.",
      "translation": "From the first of December the Yule Lads will be in Dimmuborgir by Mývatn. That is next Tuesday. They will be there until the twenty-third of December."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fréttir dagsins.",
      "translation": "Today's news."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "RÚV segir frá verkefninu Brothættar byggðir. Verkefnið hófst á Raufarhöfn árið tvö þúsund og tólf. Einn og hálfur milljarður króna hefur farið í stuðning við brothættar byggðir.",
      "translation": "RÚV reports on the project Fragile Communities. The project started in Raufarhöfn in two thousand and twelve. One and a half billion krónur have gone to support fragile communities."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fimm orð dagsins.",
      "translation": "Five words of the day."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fyrsta orðið er hvorugkynsorð.",
      "translation": "The first word is a neuter noun."
