{
  "title": "Hvasst eftir hádegi",
  "segments": [
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Góðan daginn frá Húsavík!",
      "translation": "Good morning from Húsavík!"
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Í dag er miðvikudagurinn tuttugasti og fimmti nóvember. Klukkan er rúmlega hálf sjö.",
      "translation": "Today is Wednesday the twenty-fifth of November. It is just after half past six."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Veðrið í dag.",
      "translation": "The weather today."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Í morgun er skýjað og hægur vindur. Hitinn er um eina gráðu.",
      "translation": "This morning it is cloudy with a light wind. The temperature is about one degree."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Í dag verður alskýjað en þurrt. Hitinn verður tvær til sex gráður.",
      "translation": "Today it will be overcast but dry. The temperature will be two to six degrees."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Eftir hádegi hvessir af suðaustri, tólf til þrettán metrar á sekúndu. Í kvöld léttir aðeins til.",
      "translation": "In the afternoon it gets windy from the southeast, twelve to thirteen metres per second. In the evening it clears a little."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Sólin kemur upp klukkan fimm mínútur yfir hálf ellefu og sest klukkan sextán mínútur yfir þrjú.",
      "translation": "The sun rises at twenty-five to eleven and sets at sixteen minutes past three."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Viðburðir.",
      "translation": "Events."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Aðventuævintýri á Akureyri hefst á sunnudaginn, tuttugasta og níunda nóvember. Hátíðin stendur til tuttugasta og þriðja desember.",
      "translation": "The Advent Adventure in Akureyri starts on Sunday, the twenty-ninth of November. The festival lasts until the twenty-third of December."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Sama dag eru tónleikar í Hofi klukkan átta um kvöldið. Tónleikarnir eru til minningar um Ennio Morricone.",
      "translation": "The same day there is a concert at Hof at eight in the evening. The concert is in memory of Ennio Morricone."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fréttir dagsins.",
      "translation": "Today's news."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Kvennalandsliðið í fótbolta spilar við Portúgal fimmta desember. Leikurinn er á Laugardalsvelli. Kannski verður áhorfendametið slegið.",
      "translation": "The women's national football team plays Portugal on the fifth of December. The game is at Laugardalsvöllur. Maybe the attendance record will be broken."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fimm orð dagsins.",
      "translation": "Five words of the day."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fyrsta orðið er hvorugkynsorð.",
      "translation": "The first word is a neuter noun."
    },
