{
  "title": "Kalt og skýjað á miðvikudegi",
  "segments": [
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Góðan daginn frá Húsavík.",
      "translation": "Good day from Húsavík."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Í dag er miðvikudagurinn ellefti nóvember. Klukkan er um það bil tuttugu mínútur í eitt.",
      "translation": "Today is Wednesday the eleventh of November. It is about twenty to one."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Veðrið í dag.",
      "translation": "Today's weather."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Í morgun var alskýjað og núll gráður. Það var norðlæg átt, tíu metrar á sekúndu.",
      "translation": "This morning it was overcast and zero degrees. There was a northerly wind, ten metres per second."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Í dag er hitinn í kringum núll gráður. Það er alskýjað allan daginn. Vindurinn minnkar síðdegis.",
      "translation": "Today the temperature is around zero degrees. It is overcast all day. The wind eases in the afternoon."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Um klukkan fimm fer hitinn niður í mínus eina gráðu. Seint í kvöld léttir til.",
      "translation": "Around five o'clock the temperature drops to minus one degree. Late this evening it clears up."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Sólin kom upp klukkan nítján mínútur í tíu. Hún sest klukkan þrjár mínútur yfir fjögur.",
      "translation": "The sun rose at nineteen minutes to ten. It sets at three minutes past four."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fréttir dagsins.",
      "translation": "Today's news."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Dagný Brynjarsdóttir er hætt í fótbolta. Hún skoraði þrjátíu og átta mörk fyrir landsliðið. Hún er þrjátíu og fimm ára.",
      "translation": "Dagný Brynjarsdóttir has retired from football. She scored thirty-eight goals for the national team. She is thirty-five years old."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Ísland spilar við Írland í körfubolta í kvöld. Leikurinn er í Írlandi og byrjar klukkan sjö. Hann er sýndur á RÚV tvö.",
      "translation": "Iceland plays Ireland in basketball tonight. The game is in Ireland and starts at seven. It is shown on RÚV 2."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Eldur kviknaði í bíl á Selfossi í morgun. Bíllinn var fyrir utan leikskóla. Enginn slasaðist.",
      "translation": "A fire started in a car in Selfoss this morning. The car was outside a kindergarten. Nobody was hurt."
    },
    {
      "lang": "is",
      "slow": false,
      "pause_after": false,
      "text": "Fimm orð dagsins.",
      "translation": "Five words of the day."
    },
